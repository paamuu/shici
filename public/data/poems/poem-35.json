{
  "id": "35",
  "cipai": "七律",
  "title": "和郭沫若同志",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九六一年十一月十七日",
  "paragraphs": [
    [
      "一从大地起风雷，",
      "便有精生白骨堆。",
      "僧是愚氓犹可训，",
      "妖为鬼蜮必成灾。"
    ],
    [
      "金猴奋起千钧棒，",
      "玉宇澄清万里埃。",
      "今日欢呼孙大圣，",
      "只缘妖雾又重来。"
    ]
  ],
  "theme": [
    "抒情",
    "革命",
    "咏史"
  ]
}
