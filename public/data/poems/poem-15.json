{
  "id": "15",
  "cipai": "渔家傲",
  "title": "反第一次大「围剿」",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九三一年春",
  "paragraphs": [
    [
      "万木霜天红烂漫，",
      "天兵怒气冲霄汉。",
      "雾满龙冈千嶂暗，",
      "齐声唤，",
      "前头捉了张辉瓒。"
    ],
    [
      "二十万军重入赣，",
      "风烟滚滚来天半。",
      "唤起工农千百万，",
      "同心干，",
      "不周山下红旗乱。"
    ]
  ],
  "theme": [
    "革命",
    "战争"
  ]
}
