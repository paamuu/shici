{
  "id": "27",
  "cipai": "浪淘沙",
  "title": "北戴河",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九五四年夏",
  "paragraphs": [
    [
      "大雨落幽燕，",
      "白浪滔天，",
      "秦皇岛外打鱼船。",
      "一片汪洋都不见，",
      "知向谁边？"
    ],
    [
      "往事越千年，",
      "魏武挥鞭，",
      "东临碣石有遗篇。",
      "萧瑟秋风今又是，",
      "换了人间。"
    ]
  ]
}
