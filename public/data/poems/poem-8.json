{
  "id": "8",
  "cipai": "菩萨蛮",
  "title": "黄鹤楼",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九二七年春",
  "paragraphs": [
    [
      "茫茫九派流中国，",
      "沉沉一线穿南北。",
      "烟雨莽苍苍，",
      "龟蛇锁大江。"
    ],
    [
      "黄鹤知何去？",
      "剩有游人处。",
      "把酒酹滔滔，",
      "心潮逐浪高！"
    ]
  ],
  "theme": [
    "写景",
    "抒情",
    "革命"
  ]
}
