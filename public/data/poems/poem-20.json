{
  "id": "20",
  "cipai": "十六字令三首",
  "title": "三首",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九三四年到一九三五年",
  "paragraphs": [
    [
      "山，",
      "快马加鞭未下鞍。",
      "惊回首，",
      "离天三尺三。"
    ],
    [
      "山，",
      "倒海翻江卷巨澜。",
      "奔腾急，",
      "万马战犹酣。"
    ],
    [
      "山，",
      "刺破青天锷未残。",
      "天欲堕，",
      "赖以拄其间。"
    ]
  ],
  "theme": [
    "写景",
    "抒情"
  ]
}
