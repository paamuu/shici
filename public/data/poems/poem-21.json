{
  "id": "21",
  "cipai": "七律",
  "title": "长征",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九三五年十月",
  "paragraphs": [
    [
      "红军不怕远征难，",
      "万水千山只等闲。",
      "五岭逶迤腾细浪，",
      "乌蒙磅礴走泥丸。"
    ],
    [
      "金沙水拍云崖暖，",
      "大渡桥横铁索寒。",
      "更喜岷山千里雪，",
      "三军过后尽开颜。"
    ]
  ]
}
