{
  "id": "17",
  "cipai": "菩萨蛮",
  "title": "大柏地",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九三三年夏",
  "paragraphs": [
    [
      "赤橙黄绿青蓝紫，",
      "谁持彩练当空舞？",
      "雨后复斜阳，",
      "关山阵阵苍。"
    ],
    [
      "当年鏖战急，",
      "弹洞前村壁。",
      "装点此关山，",
      "今朝更好看。"
    ]
  ],
  "theme": [
    "写景",
    "怀古",
    "革命"
  ]
}
