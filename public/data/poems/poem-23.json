{
  "id": "23",
  "cipai": "清平乐",
  "title": "六盘山",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九三五年十月",
  "paragraphs": [
    [
      "天高云淡，",
      "望断南飞雁。",
      "不到长城非好汉，",
      "屈指行程二万。"
    ],
    [
      "六盘山上高峰，",
      "红旗漫卷西风。",
      "今日长缨在手，",
      "何时缚住苍龙？"
    ]
  ],
  "theme": [
    "写景",
    "革命",
    "励志"
  ]
}
