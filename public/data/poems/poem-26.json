{
  "id": "26",
  "cipai": "浣溪沙",
  "title": "和柳亚子先生",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九五〇年十月",
  "preface": "一九五〇年国庆观剧，柳亚子先生即席赋浣溪沙，因步其韵奉和。",
  "paragraphs": [
    [
      "长夜难明赤县天，",
      "百年魔怪舞翩跹，",
      "人民五亿不团圆。"
    ],
    [
      "一唱雄鸡天下白，",
      "万方乐奏有于阗，",
      "诗人兴会更无前。"
    ]
  ],
  "theme": [
    "抒情",
    "革命"
  ]
}
