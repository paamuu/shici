{
  "id": "16",
  "cipai": "渔家傲",
  "title": "反第二次大「围剿」",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九三一年夏",
  "paragraphs": [
    [
      "白云山头云欲立，",
      "白云山下呼声急，",
      "枯木朽株齐努力。",
      "枪林逼，",
      "飞将军自重霄入。"
    ],
    [
      "七百里驱十五日，",
      "赣水苍茫闽山碧，",
      "横扫千军如卷席。",
      "有人泣，",
      "为营步步嗟何及！"
    ]
  ]
}
