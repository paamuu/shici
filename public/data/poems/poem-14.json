{
  "id": "14",
  "cipai": "蝶恋花",
  "title": "从汀州向长沙",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九三〇年七月",
  "paragraphs": [
    [
      "六月天兵征腐恶，",
      "万丈长缨要把鲲鹏缚。",
      "赣水那边红一角，",
      "偏师借重黄公略。"
    ],
    [
      "百万工农齐踊跃，",
      "席卷江西直捣湘和鄂。",
      "国际悲歌歌一曲，",
      "狂飙为我从天落。"
    ]
  ]
}
