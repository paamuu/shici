{
  "id": "18",
  "cipai": "清平乐",
  "title": "会昌",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九三四年夏",
  "paragraphs": [
    [
      "东方欲晓，",
      "莫道君行早。",
      "踏遍青山人未老，",
      "风景这边独好。"
    ],
    [
      "会昌城外高峰，",
      "颠连直接东溟。",
      "战士指看南粤，",
      "更加郁郁葱葱。"
    ]
  ],
  "theme": [
    "写景",
    "抒情",
    "革命"
  ]
}
