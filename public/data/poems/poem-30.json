{
  "id": "30",
  "cipai": "七律",
  "title": "到韶山",
  "author": "毛泽东",
  "dynasty": "现代",
  "date": "一九五九年六月",
  "preface": "一九五九年六月二十五日到韶山。离别这个地方已有三十二周年了。",
  "paragraphs": [
    [
      "别梦依稀咒逝川，",
      "故园三十二年前。",
      "红旗卷起农奴戟，",
      "黑手高悬霸主鞭。"
    ],
    [
      "为有牺牲多壮志，",
      "敢教日月换新天。",
      "喜看稻菽千重浪，",
      "遍地英雄下夕烟。"
    ]
  ]
}
